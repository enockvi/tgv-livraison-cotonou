# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SHEET_TOKEN: Jeton secret partagé avec Google Apps Script (20 caractères minimum).
# ⚠️ Ce fichier étant versionné, ne JAMAIS y laisser la valeur réelle : utilisez un espace réservé
#    et renseignez la vraie valeur dans .env (non versionné) et dans Vercel > Environment Variables.
SHEET_TOKEN="CHANGEZ_MOI_TOKEN_SECRET_32_CARACTERES"

# SHEET_WEBHOOK_URL: URL de l'application Web Google Apps Script (/exec)
SHEET_WEBHOOK_URL="https://script.google.com/macros/s/VOTRE_DEPLOIEMENT/exec"

# SHEET_CSV_URL: export CSV PUBLIC de l'onglet des tarifs, utilisé par `npm run prebuild`
# (Google Sheets > Fichier > Partager > Publier sur le web > format CSV).
# Les prix sont alors rafraîchis à chaque déploiement ; si la variable est vide, le fichier
# versionné scripts/parsed-routes.json sert de repli et le build n'échoue jamais.
SHEET_CSV_URL=""
